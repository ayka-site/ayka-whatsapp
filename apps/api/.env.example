# Azure OpenAI deployment name (should match your Azure deployment)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Azure OpenAI resource endpoint (no trailing /chat/completions path)
AZURE_OPENAI_ENDPOINT=https://bos-ayka-resource.openai.azure.com/openai/v1
# Azure OpenAI API key
AZURE_OPENAI_KEY=8u8nAm2E3DvO1AaEfUb1oFvQWh0iESdwyFPJSoU5cZDH8aEp0xaMJQQJ99CEACGhslBXJ3w3AAAAACOGpXc4

# Conversation processing lock TTL (seconds). Keep >= max expected LLM latency.
PROCESS_LOCK_TTL_SECONDS=45

# Bridge config for BOS inbound pipeline (MSME tenants)
BOS_WHATSAPP_INBOUND_URL=
BOS_WHATSAPP_INBOUND_SECRET=

# Comma-separated allowlists for BOS bridge routing (empty = disabled)
BOS_BRIDGE_PHONE_NUMBER_IDS=
BOS_BRIDGE_BUSINESS_IDS=
