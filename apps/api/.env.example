# Azure OpenAI deployment name (should match your Azure deployment)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# Azure OpenAI resource endpoint (no trailing /chat/completions path)
AZURE_OPENAI_ENDPOINT=https://aykachatbot-resource.cognitiveservices.azure.com
# Azure OpenAI API key
AZURE_OPENAI_KEY=replace_me

# Conversation processing lock TTL (seconds). Keep >= max expected LLM latency.
PROCESS_LOCK_TTL_SECONDS=45
