{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "types": ["node"]
  },
  "include": ["apps/**/*", "packages/**/*"],
  "exclude": ["node_modules", "**/node_modules", ".next", "dist", "build"]
}
