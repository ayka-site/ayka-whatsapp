# Ignore build artifacts and env files
**/node_modules
**/.next
.env
.env.*
.git
*.log
services/
SPV/
docs/
*.md

# Widget source is not needed in container builds, but the compiled embed asset is
# served by the API at /widget/embed/ayka-widget.js.
apps/widget/*
!apps/widget/package.json
!apps/widget/dist/
!apps/widget/dist/**
