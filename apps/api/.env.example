# AyKa API environment template
# NEVER put real secrets in this file or commit production .env files.

# ── Core application ─────────────────────────────────────────────
NODE_ENV=production
MONGODB_URI=mongodb://mongo:27017/ayka
REDIS_URL=redis://redis:6379
JWT_SECRET=replace-with-a-long-random-secret
# 32-byte AES key encoded as 64 hexadecimal characters.
# During SPV migration, keep the OLD production ENCRYPTION_KEY until the
# restored WhatsApp token has been decrypted and safely re-encrypted.
ENCRYPTION_KEY=replace-with-64-hex-characters

# ── Meta / WhatsApp Cloud API ───────────────────────────────────
META_APP_SECRET=replace-with-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=replace-with-webhook-verify-token

# ── Provider-neutral AI gateway ─────────────────────────────────
# Recommended initial gateway for SPV evaluation: OpenRouter.
# Direct OpenAI can be selected later without code changes.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=replace-with-openrouter-api-key
# Optional generic override; if set it takes precedence over provider-specific keys.
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Parent-facing and semantic-understanding model. Keep both independently
# configurable so we can benchmark cheaper models safely against SPV eval data.
LLM_RESPONSE_MODEL=openai/gpt-5.6-luna
LLM_UNDERSTANDING_MODEL=openai/gpt-5.6-luna
# The validation model can later be changed to a cheaper model after evaluation.
LLM_VALIDATION_MODEL=openai/gpt-5.6-luna
LLM_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional cross-model fallbacks, comma-separated.
LLM_FALLBACK_MODELS=

LLM_MAX_CONCURRENCY=5
LLM_REQUEST_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
LLM_MAX_CONTEXT_TOKENS=6000
LLM_TEMPERATURE=0.35

# ── OpenRouter routing/privacy ───────────────────────────────────
OPENROUTER_APP_NAME=AyKa AI Receptionist
OPENROUTER_SITE_URL=https://aykaai.in
OPENROUTER_ALLOW_PROVIDER_FALLBACKS=true
# Production SPV requests must not be routed to providers that train on them.
OPENROUTER_DATA_COLLECTION=deny
# Enable only after verifying the selected model has a compatible ZDR route.
OPENROUTER_ZDR=false
# Optional routing controls:
OPENROUTER_PROVIDER_SORT=
OPENROUTER_PROVIDER_ONLY=
OPENROUTER_PROVIDER_IGNORE=

# ── Semantic KB retrieval ───────────────────────────────────────
KB_RETRIEVAL_TOP_K=8
KB_RETRIEVAL_MIN_SCORE=0.18
KB_RETRIEVAL_MAX_CHARS=6500

# ── Conversation processing ─────────────────────────────────────
# Keep above expected worst-case multi-call AI latency.
PROCESS_LOCK_TTL_SECONDS=60
# School deployment does not need the real-estate follow-up worker.
RE_FOLLOWUPS_ENABLED=false

# ── Optional BOS bridge (disabled for SPV) ──────────────────────
BOS_WHATSAPP_INBOUND_URL=
BOS_WHATSAPP_INBOUND_SECRET=
BOS_BRIDGE_PHONE_NUMBER_IDS=
BOS_BRIDGE_BUSINESS_IDS=
